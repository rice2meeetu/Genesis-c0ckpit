# Copy to ~/.config/genesis/runpod-tunnel.env and fill in the values from RunPod → Connect.
# Direct TCP SSH example: RUNPOD_SSH_USER=root, host=public IP, port=random exposed SSH port.
# ssh.runpod.io example: use the full generated username, host=ssh.runpod.io, port=22.
RUNPOD_SSH_USER=replace-me
RUNPOD_SSH_HOST=replace-me
RUNPOD_SSH_PORT=22
