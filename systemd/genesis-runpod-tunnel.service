[Unit]
Description=GENESIS RunPod ComfyUI SSH tunnel
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/genesis/runpod-tunnel.env

[Service]
Type=simple
EnvironmentFile=%h/.config/genesis/runpod-tunnel.env
ExecStart=/usr/bin/ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new -L 127.0.0.1:18189:127.0.0.1:8189 ${RUNPOD_SSH_USER}@${RUNPOD_SSH_HOST} -p ${RUNPOD_SSH_PORT} -i %h/.runpod/ssh/runpodctl-ssh-key
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
