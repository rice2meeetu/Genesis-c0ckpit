[Unit]
Description=GENESIS local AI assistant
Conflicts=genesis-llama.service genesis-qwen.service
ConditionPathExists=/mnt/AI-Storage/llama.cpp/build-rocm/bin/llama-server
ConditionPathExists=/mnt/AI-Storage/GENESIS-LLM/qwen2.5-coder-14b-instruct-q4_k_m.gguf

[Service]
Type=simple
ExecStart=/mnt/AI-Storage/llama.cpp/build-rocm/bin/llama-server --model /mnt/AI-Storage/GENESIS-LLM/qwen2.5-coder-14b-instruct-q4_k_m.gguf --alias genesis-assistant --host 127.0.0.1 --port 8083 --ctx-size 16384 --n-gpu-layers 99
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.local/state/genesis/assistant.log
StandardError=append:%h/.local/state/genesis/assistant.log

[Install]
WantedBy=default.target
