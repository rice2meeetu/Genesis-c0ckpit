[Unit]
Description=GENESIS local AI assistant
# Previous local coder model retained: qwen2.5-coder-14b-instruct-q4_k_m.gguf
Conflicts=genesis-comfyui.service genesis-llama.service genesis-qwen.service genesis-voice.service
ConditionPathExists=/mnt/AI-Storage/llama.cpp/build-rocm/bin/llama-server
ConditionPathExists=/mnt/AI-Storage/GENESIS-LLM/Qwen3-Coder-30B-A3B-Instruct-UD-Q3_K_XL.gguf

[Service]
Type=simple
# KFD/SVM safety: allow mappings from the previous ROCm workload to settle.
ExecStartPre=/bin/sleep 10
ExecStart=/mnt/AI-Storage/llama.cpp/build-rocm/bin/llama-server --model /mnt/AI-Storage/GENESIS-LLM/Qwen3-Coder-30B-A3B-Instruct-UD-Q3_K_XL.gguf --alias genesis-assistant --host 127.0.0.1 --port 8083 --ctx-size 16384 --n-gpu-layers 99
Restart=on-failure
RestartSec=30
StandardOutput=append:%h/.local/state/genesis/assistant.log
StandardError=append:%h/.local/state/genesis/assistant.log

[Install]
WantedBy=default.target
