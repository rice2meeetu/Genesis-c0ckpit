[Unit]
Description=GENESIS evidence-gated AI Builder server
Conflicts=genesis-comfyui.service genesis-llama.service genesis-assistant.service genesis-qwen.service genesis-voice.service
ConditionPathExists=/mnt/AI-Storage/llama.cpp/build-rocm/bin/llama-server
ConditionPathExists=/mnt/AI-Storage/GENESIS-LLM/Qwen3-Coder-30B-A3B-Instruct-UD-Q3_K_XL.gguf

[Service]
Type=simple
ExecStart=/mnt/AI-Storage/llama.cpp/build-rocm/bin/llama-server --model /mnt/AI-Storage/GENESIS-LLM/Qwen3-Coder-30B-A3B-Instruct-UD-Q3_K_XL.gguf --host 127.0.0.1 --port 8080 --ctx-size 16384
Restart=on-failure
RestartSec=30
StandardOutput=append:%h/.local/state/genesis/builder-server.log
