[Unit]
Description=GENESIS SillyTavern local server
After=genesis-llama.service

[Service]
Type=simple
WorkingDirectory=/home/rice2meetyou/AI/SillyTavern
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.local/state/genesis/sillytavern.log
StandardError=append:%h/.local/state/genesis/sillytavern.log

[Install]
WantedBy=default.target
