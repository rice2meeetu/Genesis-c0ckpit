[Unit]
Description=GENESIS existing SillyTavern server
ConditionPathExists=/mnt/C/Users/p4uln/SillyTavern/server.js
ConditionPathIsReadWrite=/mnt/C/Users/p4uln/SillyTavern
After=genesis-llama.service

[Service]
Type=simple
WorkingDirectory=/mnt/C/Users/p4uln/SillyTavern
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.local/state/genesis/sillytavern.log
StandardError=append:%h/.local/state/genesis/sillytavern.log

[Install]
WantedBy=default.target
